VERSION=0.1.0
PORT=8080

# Name of the timetable provider and the provider secret, check provider documentation for secret format.
PROVIDER=zermelo
SECRET=https://chrlyceumdelft.zportal.nl|yourApiTokenHere 

# Admin account creds
ADMIN_USER=admin
ADMIN_PASSWORD=admin
# Duration before admin session expires
ADMIN_SESSION_DURATION=5m

# Duration before enroll code expires
ENROLL_CODE_DURATION=30m
DEVICE_TOKEN_TIMEOUT=31d