VERSION=0.1.0 # do not change
PORT=8080 # port to use 

PROVIDER=helloworld # name of timetable provider
SECRET= # provider secret, depends on select provider

ADMIN_USER=admin # username for the admin account
ADMIN_PASSWORD=admin # password for the admin account
ADMIN_SESSION_DURATION=5m # duration before an admin session expires

ENROLL_CODE_DURATION=30m # how long enroll codes are valid